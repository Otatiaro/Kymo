{
  "rules": [
    { "capture": "losses", "max": 0 },
    { "capture": "suspects", "max": 0 },
    { "capture": "contradictions", "max": 0 },

    { "subject": "SysTick_Handler (SysTick)", "metric": "period", "stat": "mean", "min": "990us", "max": "1010us" },
    { "subject": "SysTick_Handler (SysTick)", "metric": "net", "stat": "p99", "max": "20us" },

    { "subject": "control", "metric": "wake_latency", "detail": "elapsed", "stat": "count", "min": 12, "max": 12 },
    { "subject": "control", "metric": "wake_latency", "detail": "elapsed", "stat": "max", "max": "50us" },
    { "subject": "receiver", "metric": "wake_latency", "detail": "handler:application::device_handler (IRQ0)", "stat": "count", "min": 1, "max": 1 },
    { "subject": "receiver", "metric": "wake_latency", "detail": "handler:application::device_handler (IRQ0)", "stat": "max", "max": "50us" },
    { "subject": "ping", "metric": "wake_latency", "detail": "task:pong", "stat": "count", "min": 3, "max": 3 },
    { "subject": "pong", "metric": "wake_latency", "detail": "task:ping", "stat": "count", "min": 3, "max": 3 },

    { "subject": "application::contested_mutex_storage", "metric": "wait", "detail": "control", "stat": "count", "min": 1, "max": 1 },
    { "subject": "application::contested_mutex_storage", "metric": "wait", "detail": "control", "stat": "max", "max": "250us" },
    { "subject": "application::contested_mutex_storage", "metric": "hold", "detail": "low", "stat": "count", "min": 1, "max": 1 }
  ]
}
