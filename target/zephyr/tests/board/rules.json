{
  "rules": [
    { "capture": "losses", "max": 0 },
    { "capture": "suspects", "max": 0 },
    { "capture": "contradictions", "max": 0 },

    { "subject": "sys_clock_isr (SysTick)", "metric": "period", "stat": "mean", "min": "9990us", "max": "10010us" },
    { "subject": "sys_clock_isr (SysTick)", "metric": "net", "stat": "p99", "max": "20us" },

    { "subject": "main", "metric": "wake_latency", "detail": "elapsed", "stat": "count", "min": 10, "max": 10 },
    { "subject": "main", "metric": "wake_latency", "detail": "elapsed", "stat": "max", "max": "50us" },
    { "subject": "receiver", "metric": "wake_latency", "detail": "handler:application::device_handler (IRQ128)", "stat": "count", "min": 1, "max": 1 },
    { "subject": "receiver", "metric": "wake_latency", "detail": "handler:application::device_handler (IRQ128)", "stat": "max", "max": "50us" },
    { "subject": "ping", "metric": "wake_latency", "detail": "task:pong", "stat": "count", "min": 3, "max": 3 },
    { "subject": "pong", "metric": "wake_latency", "detail": "task:ping", "stat": "count", "min": 3, "max": 3 },

    { "subject": "application::contested_mutex", "metric": "wait", "detail": "main", "stat": "count", "min": 1, "max": 1 },
    { "subject": "application::contested_mutex", "metric": "wait", "detail": "main", "stat": "max", "max": "250us" },
    { "subject": "application::contested_mutex", "metric": "hold", "detail": "low", "stat": "count", "min": 1, "max": 1 }
  ]
}
